# Secrets -- never commit. Matches at any depth, e.g. src/.env
.env
.env.*
**/.env
**/.env.*
!.env.example

# Virtualenvs
.venv/
**/.venv/
venv/

# Caches and build output
.*_cache
__pycache__/
*.claude
dist/

# Raw API dumps: contain inverter serials and station ids
data/raw/

# forecast.solar client: kept locally for future integration, not part of this repo
src/forecast_solar/
tests/test_forecast_solar.py
