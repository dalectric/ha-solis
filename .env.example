# Copy to .env and fill in. Solis issues these three values when you request API access.
# .env is gitignored -- never commit real credentials.
SOLIS_ID=your-key-id
SOLIS_SECRET=your-key-secret
SOLIS_URL=https://www.soliscloud.com:13333/

# Optional. Per-request timeout in seconds. The API is slow (median ~16s, tail past
# 30s), so the default is deliberately generous.
# SOLIS_TIMEOUT=60
