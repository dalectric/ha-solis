# Copy to .env and fill in. Solis issues these three values when you request API access.
# .env is gitignored -- never commit real credentials.
SOLIS_ID=your-key-id
SOLIS_SECRET=your-key-secret
SOLIS_URL=https://www.soliscloud.com:13333/

# Optional. Per-request timeout in seconds. The API is slow (median ~16s, tail past
# 30s), so the default is deliberately generous.
# SOLIS_TIMEOUT=60

# forecast.solar site configuration. Your latitude/longitude identify where you live,
# so they are kept out of source control.
FORECAST_LATITUDE=51.5
FORECAST_LONGITUDE=-0.12
# JSON list, one entry per array. decline = tilt in degrees, azimuth = 0 south /
# -90 east / 90 west, kwp = per-panel peak kW, modules = panel count.
FORECAST_ARRAYS=[{"name":"South","decline":35,"azimuth":0,"kwp":0.4,"modules":10}]
